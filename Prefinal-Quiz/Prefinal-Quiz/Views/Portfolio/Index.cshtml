@model List<Prefinal_Quiz.Models.Project>

<div class="portfolio-container">


    <div class="portfolio-title">
        <h1>Portfolio</h1>
        <p>BSIT 31E1</p>
    </div>

    <div class="toc">

        <h2>Table of Contents</h2>

        <div class="toc-category">
            <h3>Prelim</h3>

            <ul>
                @foreach (var project in Model.Where(p => p.Category == "Prelim"))
                {
                    <li>
                        <a href="#project-@project.Id">
                            @project.Title
                        </a>
                    </li>
                }
            </ul>
        </div>


        <div class="toc-category">
            <h3>Midterm</h3>

            <ul>
                @foreach (var project in Model.Where(p => p.Category == "Midterm"))
                {
                    <li>
                        <a href="#project-@project.Id">
                            @project.Title
                        </a>
                    </li>
                }
            </ul>
        </div>


        <div class="toc-category">
            <h3>Prefinal</h3>

            <ul>
                @foreach (var project in Model.Where(p => p.Category == "Prefinal"))
                {
                    <li>
                        <a href="#project-@project.Id">
                            @project.Title
                        </a>
                    </li>
                }
            </ul>
        </div>

    </div>


    @foreach (var category in new[] { "Prelim", "Midterm", "Prefinal" })
    {
        var categoryProjects = Model
        .Where(p => p.Category == category)
        .ToList();

        if (categoryProjects.Any())
        {
            <section class="project-category">

                <h2>@category</h2>

                <div class="project-grid">

                    @foreach (var project in categoryProjects)
                    {
                        <div class="project-card" id="project-@project.Id">

                            <img src="@project.ImageUrl"
                                 alt="@project.Title"
                                 class="project-image" />

                            <div class="project-content">

                                <h3>@project.Title</h3>

                                <p>
                                    @project.Description
                                </p>

                                <p class="technologies">
                                    <strong>Technology:</strong>
                                    @project.Technologies
                                </p>

                                <div class="project-buttons">

                                    <a href="@project.GithubUrl"
                                       target="_blank"
                                       class="github-button">
                                        GitHub
                                    </a>

                                    <a asp-controller="Portfolio"
                                       asp-action="Details"
                                       asp-route-id="@project.Id"
                                       class="btn-primary">
                                        View Details
                                    </a>

                                </div>

                            </div>

                        </div>
                    }
                </div>
            </section>
        }
    }
</div>